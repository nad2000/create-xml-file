<?xml version="1.0" encoding="ISO-8859-1"?>
<xsd:schema xmlns:sdt="http://www.cra-arc.gc.ca/xmlns/sdt/2-0-0" xmlns:comm="http://www.cra-arc.gc.ca/xmlns/comm/2012/1-0-0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.cra-arc.gc.ca/xmlns/comm/2012/1-0-0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1-0-0">
	<xsd:import namespace="http://www.cra-arc.gc.ca/xmlns/sdt/2-0-0" schemaLocation="standarddatatypes.xsd"/>
	<xsd:element name="SoftwareID">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">Ends with "E" or "e" for EOLP. Ends with "F" or "f" for EOL. Ends with "G" or "g" for Netfile.</xsd:documentation>
            		<xsd:documentation xml:lang="fr">Se termine avec un "E" ou "e" pour TED en direct plus. Se termine avec un "F" ou "f" pour TED en direct. Se termine avec un "G" ou "g" pour Impôtnet.</xsd:documentation>      		
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="sdt:IDType">
				<xsd:length value="4"/>
				<xsd:pattern value="[0-9]{3}[EeFfGg]"/>
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="SoftwareRevisionDate" type="sdt:DateType">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">Format is YYYY-MM-DD</xsd:documentation>
			<xsd:documentation xml:lang="fr">Le format est AAAA-MM-JJ</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:element name="TaxationCentreCode">
		<xsd:simpleType>
			<xsd:restriction base="sdt:CodeType">
				<xsd:length value="2"/>
				<xsd:pattern value="[9][2 4-9]"/>
				<xsd:enumeration value="92"/>
				<xsd:enumeration value="94"/>
				<xsd:enumeration value="95"/>
				<xsd:enumeration value="96"/>
				<xsd:enumeration value="97"/>
				<xsd:enumeration value="98"/>
				<xsd:enumeration value="99"/>
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="TaxpayerName" type="comm:CompleteIndividualNameType"/>
	<xsd:complexType name="CompleteIndividualNameType">
		<xsd:sequence>
			<xsd:element ref="comm:GivenName"/>
			<xsd:element ref="comm:FamilyName"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="IndividualNameType">
		<xsd:sequence>
			<xsd:element ref="comm:GivenName" minOccurs="0"/>
			<xsd:element ref="comm:FamilyName"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="IndividualGivenNameType">
		<xsd:simpleContent>
			<xsd:restriction base="sdt:NameType">
				<xsd:maxLength value="30"/>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:element name="GivenName">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:restriction base="comm:IndividualGivenNameType"/>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="IndividualFamilyNameType">
		<xsd:simpleContent>
			<xsd:restriction base="sdt:NameType">
				<xsd:maxLength value="30"/>
			</xsd:restriction>
		</xsd:simpleContent>
	</xsd:complexType>
	<xsd:element name="FamilyName">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:restriction base="comm:IndividualFamilyNameType"/>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:simpleType name="IndividualSocialInsuranceNumberType">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">STANDARD CRA-SPECIFIC GLOBAL CONSTRUCTS SIN. Must pass MOD-10 check.</xsd:documentation>
			<xsd:documentation xml:lang="fr">STANDARD SPÉCIFIQUE DE L'ARC POUR GÉNÉRER UN NAS. Doit passer le contrôle MOD-10.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="sdt:NumberType">
			<xsd:length value="9"/>
			<xsd:pattern value="[0-9]{9}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="ContactAddressType">
		<xsd:sequence>
			<xsd:element ref="comm:BusinessAddressStreetText"/>
			<xsd:element ref="comm:AddressMunicipalityName"/>
			<xsd:element ref="comm:AddressProvinceCode"/>
			<xsd:element ref="comm:AddressPostalCode"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="CanadianMailingAddress" type="comm:CanadianMailingAddressType"/>
	<xsd:complexType name="CanadianMailingAddressType">
		<xsd:sequence>
			<xsd:element ref="comm:AddressStreetText"/>
			<xsd:element ref="comm:AddressMunicipalityName"/>
			<xsd:element ref="comm:AddressProvinceCode"/>
			<xsd:element ref="comm:AddressPostalCode"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="AddressCareOfLineText">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:restriction base="sdt:TextType">
					<xsd:maxLength value="26"/>
				</xsd:restriction>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="BusinessAddressStreetText">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:restriction base="sdt:TextType">
					<xsd:maxLength value="60"/>
				</xsd:restriction>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AddressStreetText">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:restriction base="sdt:TextType">
					<xsd:maxLength value="60"/>
				</xsd:restriction>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AddressMunicipalityName">
		<xsd:complexType>
			<xsd:simpleContent>
				<xsd:restriction base="sdt:NameType">
					<xsd:maxLength value="50"/>
				</xsd:restriction>
			</xsd:simpleContent>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="AddressProvinceCode">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">Must be one of the following abbreviations: NL - Newfoundland, PE - Prince Edward Island, NS - Nova Scotia, NB - New Brunswick, QC - Quebec, ON - Ontario, MB - Manitoba, SK - Saskatchewan, AB - Alberta, BC - British Columbia, YT - Yukon, NU - Nunavut, NT - Northwest Territories</xsd:documentation>
			<xsd:documentation xml:lang="fr">Doit être l'une des abréviations suivantes: NL - Terre-Neuve-et-Labrador, PE - Île-du-Prince-Édouard, NS - Nouvelle-Écosse, NB - Nouveau-Brunswick, QC - Québec, ON - Ontario, MB - Manitoba, SK - Saskatchewan, AB - Alberta, BC - Colombie-Britannique, YT - Yukon, NU - Nunavut, NT - Territoires du Nord-Ouest</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="comm:CanadianProvinceCodeType">
				<xsd:length value="2"/>
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:simpleType name="CanadianProvinceCodeType">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">Must be one of the following abbreviations: NL - Newfoundland, PE - Prince Edward Island, NS - Nova Scotia, NB - New Brunswick, QC - Quebec, ON - Ontario, MB - Manitoba, SK - Saskatchewan, AB - Alberta, BC - British Columbia, YT - Yukon, NU - Nunavut, NT - Northwest Territories</xsd:documentation>
            <xsd:documentation xml:lang="fr">Doit être l'une des abréviations suivantes: NL - Terre-Neuve-et-Labrador, PE - Île-du-Prince-Édouard, NS - Nouvelle-Écosse, NB - Nouveau-Brunswick, QC - Québec, ON - Ontario, MB - Manitoba, SK - Saskatchewan, AB - Alberta, BC - Colombie-Britannique, YT - Yukon, NU - Nunavut, NT - Territoires du Nord-Ouest</xsd:documentation>   		
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:length value="2"/>
			<xsd:enumeration value="NL"/>
			<xsd:enumeration value="PE"/>
			<xsd:enumeration value="NS"/>
			<xsd:enumeration value="NB"/>
			<xsd:enumeration value="QC"/>
			<xsd:enumeration value="ON"/>
			<xsd:enumeration value="MB"/>
			<xsd:enumeration value="SK"/>
			<xsd:enumeration value="AB"/>
			<xsd:enumeration value="BC"/>
			<xsd:enumeration value="YT"/>
			<xsd:enumeration value="NU"/>
			<xsd:enumeration value="NT"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="AddressPostalCode">
		<xsd:simpleType>
			<xsd:restriction base="comm:CanadianPostalCodeType">
				<xsd:length value="6"/>
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:simpleType name="CanadianPostalCodeType">
		<xsd:restriction base="sdt:CodeType">
			<xsd:length value="6"/>
			<xsd:pattern value="([A-Za-z][0-9]){3}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="NorthAmericanTelephoneNumberType">
		<xsd:sequence>
			<xsd:element ref="comm:TelephoneAreaCode"/>
			<xsd:element ref="comm:TelephoneLocalNumber"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="TelephoneAreaCode">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">Telephone Area Code</xsd:documentation>
			<xsd:documentation xml:lang="fr">Indicatif régional du numéro de téléphone</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="sdt:CodeType">
				<xsd:length value="3"/>
				<xsd:pattern value="[1-9][0-9]{2}"/>
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="TelephoneLocalNumber">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">Telephone Number</xsd:documentation>
			<xsd:documentation xml:lang="fr">Numéro de téléphone</xsd:documentation>
		</xsd:annotation>
		<xsd:simpleType>
			<xsd:restriction base="sdt:NumberType">
				<xsd:length value="7"/>
				<xsd:pattern value="[0-9]{7}"/>
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="ReturnLine" type="comm:GenericReturnLineType">
		<xsd:annotation>
			<xsd:documentation xml:lang="en">Free Form misc data</xsd:documentation>
			<xsd:documentation xml:lang="fr">Données diverses format non structuré</xsd:documentation>
		</xsd:annotation>
	</xsd:element>
	<xsd:complexType name="GenericReturnLineType">
		<xsd:sequence>
			<xsd:element ref="comm:FieldCode"/>
			<xsd:element ref="comm:FieldValue"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:element name="FieldCode">
		<xsd:simpleType>
			<xsd:restriction base="sdt:CodeType">
				<xsd:minLength value="3"/>
				<xsd:maxLength value="4"/>
				<xsd:pattern value="[1-9][0-9]{2,3}"/>
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:element name="FieldValue" type="sdt:ValueType"/>
	<xsd:element name="EnvironmentCode">
		<xsd:simpleType>
			<xsd:restriction base="comm:EnvironmentType">
				<xsd:length value="2"/>
			</xsd:restriction>
		</xsd:simpleType>
	</xsd:element>
	<xsd:simpleType name="EnvironmentType">
		<xsd:restriction base="sdt:CodeType">
			<xsd:length value="2"/>
			<xsd:enumeration value="UT"/>
			<xsd:enumeration value="UA"/>
			<xsd:enumeration value="SI"/>
			<xsd:enumeration value="OT"/>
			<xsd:enumeration value="TR"/>
			<xsd:enumeration value="PR"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>
