<?xml version="1.0" encoding="ISO-8859-1"?>
<xsd:schema xmlns:net="http://www.cra-arc.gc.ca/xmlns/netfile/2012/1-0-0" xmlns:t1="http://www.cra-arc.gc.ca/xmlns/t1/2012/1-0-0" xmlns:sfd="http://www.cra-arc.gc.ca/xmlns/sfd/2012/1-0-0" xmlns:comm="http://www.cra-arc.gc.ca/xmlns/comm/2012/1-0-0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.cra-arc.gc.ca/xmlns/netfile/2012/1-0-0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="netfile/2012/1-0-0">
